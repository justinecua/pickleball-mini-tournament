# Docker Compose settings. Copy to .env:  cp .env.example .env
# Django settings live in backend/.env (see backend/.env.example).

# Host port for the web container (bound to 127.0.0.1). Must not clash with other containers.
HOST_PORT=8095

# Public site URL (used for QR-code links in the frontend build).
PUBLIC_URL=https://picklexp.site
