# Copy to backend/.env:  cp .env.example .env

SECRET_KEY=change-me
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=False
TIME_ZONE=Asia/Manila

ALLOWED_HOSTS=picklexp.site,www.picklexp.site
CSRF_TRUSTED_ORIGINS=https://picklexp.site,https://www.picklexp.site
#CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=https://picklexp.site,https://www.picklexp.site

# Cookies (Django admin)
# For development
# SECURE=False
# For production
SECURE=True

# Database: leave DB_NAME empty to use the local SQLite file (backend/db.sqlite3).

# #local postgre
# DB_NAME=picklexp
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# live Postgre (from inside Docker, the server itself is host.docker.internal)
DB_NAME=picklexp
DB_USER=
DB_PASSWORD=
DB_HOST=host.docker.internal
DB_PORT=5433
